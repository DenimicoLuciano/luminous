# Luminous environment — copy to .env and fill in. NEVER commit .env.
PORT=3000
DATA_DIR=./data

# Developer account: the account registered with this email automatically
# gets the 'developer' role (badge, founder profile title, admin panel).
DEVELOPER_EMAIL=denimdenimdenim00@gmail.com

# AI features (mentors + companions). Leave empty to run without AI —
# the app shows a clear "AI not configured" state instead of breaking.
LUMIAI_API_KEY=
LUMIAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# LumiCoin Core (unified Lumiworld LUMI ledger). Optional — set BOTH to
# connect Lumiail-linked users' coin balances, live gifts and host payouts
# to LumiCoin Core. Leave empty to run on the local wallet exactly as
# before; any Core outage also falls back to the local wallet.
LUMICOIN_CORE_URL=
LUMICOIN_PRODUCT_KEY=
